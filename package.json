{
  "name": "slidesmith",
  "version": "0.3.0",
  "description": "Desktop app to detect Skyrim mod body type and run native BodySlide asset conversions.",
  "type": "module",
  "main": "dist-main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle:python-deps": "node scripts/bundle-python-deps.mjs",
    "build:main": "tsc -p tsconfig.main.json && node scripts/write-pkg.mjs",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "electron:dev": "npm run build:main && npm run build:renderer && electron .",
    "package:win": "npm run bundle:python-deps && npm run build:main && npm run build:renderer && npm exec --yes electron-builder -- --win portable --publish never",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.slidesmith.app",
    "productName": "SlideSmith",
    "artifactName": "SlideSmith-${version}.${ext}",
    "asarUnpack": [
      "dist-main/python_engine/**",
      "dist-main/python_deps/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-main/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosephsDeadish/Bodyslide-Converter-tool.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JosephsDeadish/Bodyslide-Converter-tool/issues"
  },
  "homepage": "https://github.com/JosephsDeadish/Bodyslide-Converter-tool#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "42.2.0",
    "electron-builder": "^26.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
