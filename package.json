{
  "name": "bodyslide-converter-tool",
  "version": "1.0.0",
  "description": "CLI to detect source body type and generate Bodyslide conversion plans.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bodyslide-converter": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:exe:prep": "tsc -p tsconfig.exe.json",
    "build:exe": "npm run build:exe:prep && pkg dist-exe/index.js --targets node20-win-x64 --output release/bodyslide-converter.exe",
    "build:exe:linux": "npm run build:exe:prep && pkg dist-exe/index.js --targets node20-linux-x64 --output release/bodyslide-converter",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosephsDeadish/Bodyslide-Converter-tool.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JosephsDeadish/Bodyslide-Converter-tool/issues"
  },
  "homepage": "https://github.com/JosephsDeadish/Bodyslide-Converter-tool#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "@yao-pkg/pkg": "^6.6.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
