{
  "name": "bodyslide-converter-tool",
  "version": "1.0.0",
  "description": "Desktop app to detect Skyrim mod body type and run native BodySlide asset conversions.",
  "type": "module",
  "main": "dist-main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-renderer.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "electron:dev": "npm run build:main && electron .",
    "package:win": "npm run build:main && electron-builder --win portable",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.bodyslide.converter",
    "productName": "Bodyslide Converter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-main/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosephsDeadish/Bodyslide-Converter-tool.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JosephsDeadish/Bodyslide-Converter-tool/issues"
  },
  "homepage": "https://github.com/JosephsDeadish/Bodyslide-Converter-tool#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
