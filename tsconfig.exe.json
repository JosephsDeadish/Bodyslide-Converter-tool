{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-exe",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts"]
}
